# MySQL Database Credentials
MYSQL_ROOT_PASSWORD=passw0rd
MYSQL_PASSWORD=passw0rd
MYSQL_USER=deagentnet
MYSQL_DATABASE=deagentnet

# Internal Service Key for authentication between backend, validators, and event-handler
INTERNAL_SERVICE_KEY=can_internal_secret_key_2026

# Ollama local configuration for hosted agents
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b

# Validator 1: Fireworks (DeepSeek 4 Flash)
VALIDATOR_1_LLM_PROVIDER=fireworks
VALIDATOR_1_LLM_MODEL=accounts/fireworks/models/deepseek-v4-flash
FIREWORKS_API_KEY=your_fireworks_api_key_here

# Validator 2: Google (Gemini 3.1 Flash Lite)
VALIDATOR_2_LLM_PROVIDER=google
VALIDATOR_2_LLM_MODEL=gemini-3.1-flash-lite
GEMINI_API_KEY=your_gemini_api_key_here

# Validator 3: OpenRouter (NVIDIA Nemotron 3 Ultra)
VALIDATOR_3_LLM_PROVIDER=openrouter
VALIDATOR_3_LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_API_KEY=your_openrouter_api_key_here
