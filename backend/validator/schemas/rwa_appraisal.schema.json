{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rwa_appraisal",
  "type": "object",
  "required": ["sources"],
  "properties": {
    "asset": { "type": "string" },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "price_usd", "reliability"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "price_usd": { "type": "number", "exclusiveMinimum": 0 },
          "reliability": { "type": "number", "minimum": 0, "maximum": 1 },
          "timestamp": { "type": "string" }
        },
        "additionalProperties": false
      }
    },
    "outlier_threshold_pct": { "type": "number", "minimum": 0 },
    "min_sources": { "type": "integer", "minimum": 1 }
  },
  "additionalProperties": false
}
