{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "fixture_meta",
  "type": "object",
  "required": ["data"],
  "properties": {
    "captured_at": {
      "type": "string",
      "format": "date-time"
    },
    "source": {
      "type": "string",
      "enum": ["platform", "creator", "seed", "benchmark"]
    },
    "data": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
