{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "rwa_compliance",
  "type": "object",
  "required": [
    "current_collateral_factor",
    "collateral_floor",
    "news_items"
  ],
  "properties": {
    "issuer": { "type": "string" },
    "current_collateral_factor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "collateral_floor": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "macro_risk_score": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "news_items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "headline"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "headline": { "type": "string", "minLength": 1 },
          "severity": {
            "type": "string",
            "enum": ["low", "medium", "high"]
          },
          "verified": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
