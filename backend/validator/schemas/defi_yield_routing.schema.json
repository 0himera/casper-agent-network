{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "defi_yield_routing",
  "type": "object",
  "required": ["amount_cspr", "gas_price_motes", "pools"],
  "properties": {
    "amount_cspr": {
      "type": "integer",
      "minimum": 1
    },
    "gas_price_motes": {
      "type": "integer",
      "minimum": 0
    },
    "pools": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "apy"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "apy": { "type": "number", "minimum": 0, "maximum": 1 },
          "fee_bps": { "type": "integer", "minimum": 0 },
          "tvl_usd": { "type": "number", "minimum": 0 },
          "volume_24h_usd": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
