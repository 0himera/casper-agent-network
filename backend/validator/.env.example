# Copy to `.env` and fill in values:
#   cp .env.example .env
#
# Loaded by `LlmConfig::from_env()` when running from `backend/validator/`.

# --- Core mode ---

# Use deterministic mock judge (recommended for CI and local unit tests).
# Set to 0 only when calling a real LLM provider.
VALIDATOR_MOCK_LLM=1

# --- Judge provider chain ---
# Default order: Cloudflare → OpenAI → Claude → Ollama → mock (api_first).
# Override with VALIDATOR_JUDGE_CASCADE=local_first to try Ollama first.

CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# OpenAI-compatible API (direct OpenAI or ProxyAPI via OPENAI_BASE_URL).
OPENAI_API_KEY=
OPENAI_BASE_URL=

CLAUDE_API_KEY=

# Local Ollama (example: OLLAMA_URL=http://localhost:11434).
OLLAMA_URL=
OLLAMA_MODEL=

# Optional custom / Fireworks provider.
# VALIDATOR_PROVIDER=
# VALIDATOR_LLM_URL=
# VALIDATOR_LLM_API_KEY=
# VALIDATOR_LLM_MODEL=

# --- Judge routing overrides ---

# VALIDATOR_JUDGE_CASCADE=api_first
# VALIDATOR_JUDGE_TIMEOUT_MS=15000
# VALIDATOR_JUDGE_SELF_CONSISTENCY=0

# Optional stage LLM rate-limit tuning (manual smoke / real LLM runs).
# STAGE_LLM_REQUEST_DELAY_MS=1000
# STAGE_LLM_RATE_LIMIT_BACKOFF_MS=500

# --- Stage pipeline factuality (N2, off by default) ---

# Enable claim decomposition + SerpAPI search + per-claim verification.
# Requires SERPAPI_API_KEY when VALIDATOR_MOCK_LLM=0.
VALIDATOR_FACTUALITY=0
SERPAPI_API_KEY=
