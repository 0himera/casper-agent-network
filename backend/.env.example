# Copy to `.env` and fill in values:
#   cp .env.example .env
#
# Backend API server configuration.
# LLM / validator keys live in `backend/validator/.env` (see validator/.env.example).

# Local MySQL (adjust user/password/host for your setup).
# Docker compose often uses port 3307 — see DOCKER_MYSQL_PORT_3307.md.
DATABASE_URL=mysql://root@localhost:3306/casper_agent_network
# For E2 DB tests: export DATABASE_URL before `cargo test` (tests do not load `.env`).
# Example (Docker): DATABASE_URL=mysql://deagentnet:passw0rd@127.0.0.1:3307/deagentnet cargo test --lib db_ -- --ignored --test-threads=1

PORT=3000

# Note: legacy `llm_judge` uses OpenAI directly and does not read OPENAI_BASE_URL.
# Stage pipeline uses `validator-engine` with its own `.env` in backend/validator/.
# Set VALIDATOR_PIPELINE=stage to enable stage pipeline on live `/execute` (default: legacy).
# Set VALIDATOR_FACTUALITY=1 to enable S4 factuality (requires SERPAPI_API_KEY for real search).

# Internal service auth (required for /execute, /validate, /admin/exams/dispatch).
INTERNAL_SERVICE_KEY=your-internal-service-key

# --- Exam pipeline (E0–E5 MVP) ---
# Exam tasks bypass VALIDATOR_PIPELINE; routing is by exam_assignments row.
# On-chain weight for pass/fail (default 300). Both outcomes call submit_complete.
EXAM_WEIGHT=300
# Set to 1 only in local/CI tests to skip agent_network_submit_complete (see tasks.rs).
# EXAM_SKIP_ONCHAIN=1
# Post-MVP only (E6): second-chance LLM equality after Type H mismatch. Not implemented in MVP.
# EXAM_LLM_EQUALITY=0

# Exam dispatch (E4) — admin POST /api/admin/exams/dispatch
# Auth: Authorization header must equal INTERNAL_SERVICE_KEY (fail-closed if unset).
# Probabilities must stay < 1.0 (values >= 1.0 are clamped to 0.99).
EXAM_DISPATCH_PROB_AUDIT=0.2
EXAM_DISPATCH_PROB_REHAB=0.5
EXAM_MAX_PER_AGENT_PER_PERIOD=1
EXAM_DISPATCH_PERIOD_HOURS=24
EXAM_REHAB_SCORE_THRESHOLD=0
EXAM_AUDIT_ACTIVE_JOBS_THRESHOLD=2
EXAM_DISPATCH_BUDGET_MOTES=5000000000
# Defaults to ADMIN_ACCOUNT when unset.
# EXAM_DISPATCH_CREATOR_PUBLIC_KEY=
#
# E7 background autoplanner (middle scenario Phase 1) — default ON.
# Calls dispatch_once() in-process; admin POST /api/admin/exams/dispatch remains fallback.
# Set to 0 to disable (rollback).
# EXAM_DISPATCH_LOOP_ENABLED=1
# EXAM_DISPATCH_LOOP_INTERVAL_SECS=300
#
# Middle scenario Phase 3 — urgency-based agent selection (default ON).
# Set to 'bucket' for rollback.
# EXAM_SELECTION_MODE=urgency
# EXAM_URGENCY_BASE_PROB=0.1
# EXAM_URGENCY_TASK_WEIGHT=0.05
# EXAM_URGENCY_VARIANCE_WEIGHT=0.2
# EXAM_URGENCY_RECENT_VERDICTS=5
#
# Middle scenario Phase 4 — off-chain smoothed exam score (does not change on-chain submit).
# EXAM_SMOOTHED_EMA_ALPHA=0.3
#
# Middle scenario Phase 5 — global leaderboard read model (default off; rollback = 0).
# EXAM_LEADERBOARD_USE_SMOOTHED=0
#
# Manual / cron dispatch example:
# curl -X POST http://localhost:3000/api/admin/exams/dispatch \
#   -H "Authorization: $INTERNAL_SERVICE_KEY"

# --- x402 micropayments ---
# HMAC secret for challengeToken. If unset, backend generates an ephemeral secret
# at process start (live W5-F14 expiry assert requires the same value on host).
# For Wave5 live F14 expiry, set the same value in backend/.env and host env:
X402_SECRET=can_x402_secret_key_2026_testnet
# Set DISABLE_X402=1 only for local tests that must skip payment verification.
